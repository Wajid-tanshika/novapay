<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Glowing Orbit Ring -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 53.9,24 Z"
        android:strokeWidth="3"
        android:strokeColor="#4DFFFFFF"
        android:fillColor="#00000000" />

    <!-- Sleek Wallet Body with Premium Metallic/Silver Gradient -->
    <path
        android:pathData="M34,44 c0,-3.3 2.7,-6 6,-6 h28 c3.3,0 6,2.7 6,6 v18 c0,3.3 -2.7,6 -6,6 h-28 c-3.3,0 -6,-2.7 -6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="38"
                android:endX="74"
                android:endY="68">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#CFD8DC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wallet Latch -->
    <path
        android:pathData="M66,49 c0,-1.1 0.9,-2 2,-2 h6 c1.1,0 2,0.9 2,2 v8 c0,1.1 -0.9,2 -2,2 h-6 c-1.1,0 -2,-0.9 -2,-2 z"
        android:fillColor="#FFB300" />

    <!-- Latch Center Dot -->
    <path
        android:pathData="M70,53 A2,2 0 1,1 69.9,53 Z"
        android:fillColor="#FFFFFF" />

    <!-- Fast-pay Dynamic Gold Lightning Bolt -->
    <path
        android:pathData="M58,26 L38,54 h14 L44,82 L70,48 H52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="26"
                android:endX="70"
                android:endY="82">
                <item android:offset="0.0" android:color="#FFF176" />
                <item android:offset="0.5" android:color="#FFB300" />
                <item android:offset="1.0" android:color="#FF8F00" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
